rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: get the caller's role from the users collection
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOperator() { return userRole() == 'operator'; }
    function isSupervisor() { return userRole() == 'supervisor'; }
    function isManager() { return userRole() == 'manager'; }

    // Valid rejection reasons — must match the client-side enum exactly
    function validRejectionReason(reason) {
      return reason in ['Dimensional', 'Surface finish', 'Burr', 'Material defect', 'Setup error', 'Other'];
    }

    // Numeric field validation for entry data
    function validEntryNumbers(data) {
      return data.plannedQty is int && data.plannedQty >= 0
          && data.producedQty is int && data.producedQty >= 0
          && data.rejectedQty is int && data.rejectedQty >= 0
          && data.rejectedQty <= data.producedQty
          && data.downtimeMinutes is int && data.downtimeMinutes >= 0
          && data.downtimeMinutes <= 60;
    }

    // Conditional field validation
    function validConditionalFields(data) {
      // Rejection reason required and must be from enum when rejected > 0
      let rejectionOk = (data.rejectedQty == 0) ||
        (data.rejectionReason != null && validRejectionReason(data.rejectionReason));

      // Downtime reason required when downtime > 0
      let downtimeOk = (data.downtimeMinutes == 0) ||
        (data.downtimeReason != null && data.downtimeReason.size() > 0);

      // Remark required when rejection % > 10% (strictly greater)
      let remarkOk = (data.producedQty == 0) ||
        (data.rejectedQty * 1000 <= data.producedQty * 100) ||
        (data.remarks != null && data.remarks.size() > 0);

      return rejectionOk && downtimeOk && remarkOk;
    }

    // --- Users collection: read-only for authenticated users ---
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false; // seeded via admin SDK only
    }

    // --- Entries collection: role-based access ---
    match /entries/{entryId} {

      // READ
      // Operators see only their own entries
      // Supervisors and managers see all
      allow read: if request.auth != null && (
        (isOperator() && resource.data.operatorId == request.auth.uid) ||
        isSupervisor() ||
        isManager()
      );

      // CREATE — operators only, must be draft, must pass validation
      allow create: if request.auth != null
        && isOperator()
        && request.resource.data.operatorId == request.auth.uid
        && request.resource.data.status == 'draft'
        && validEntryNumbers(request.resource.data)
        && validConditionalFields(request.resource.data);

      // UPDATE — depends on role and current status
      allow update: if request.auth != null && (
        // Operator editing their own draft or returned entry
        (
          isOperator()
          && resource.data.operatorId == request.auth.uid
          && resource.data.status in ['draft', 'returned']
          // Allowed transitions: draft→draft, draft→submitted, returned→draft, returned→submitted
          && request.resource.data.status in ['draft', 'submitted']
          // Can't change ownership
          && request.resource.data.operatorId == resource.data.operatorId
          && validEntryNumbers(request.resource.data)
          && validConditionalFields(request.resource.data)
        )
        ||
        // Supervisor approving or returning a submitted entry
        (
          isSupervisor()
          && resource.data.status == 'submitted'
          && request.resource.data.status in ['approved', 'returned']
          // When returning, remark is mandatory
          && (
            request.resource.data.status == 'approved'
            || (request.resource.data.remarks != null && request.resource.data.remarks.size() > 0)
          )
        )
      );

      // DELETE — nobody can delete entries (audit trail)
      allow delete: if false;
    }
  }
}
